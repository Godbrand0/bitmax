# Copy to .env.local and fill in for local dev, or set these in your
# hosting provider's environment variable settings for a real deployment.

# Which network the app targets: mainnet | testnet | devnet. Defaults to
# mainnet if unset - see lib/network.ts.
NEXT_PUBLIC_NETWORK=mainnet

# The account that deployed bitmax-vault / ve-stx-lock / bitmax-boost-distributor.
# Required for anything beyond the devnet default to work correctly.
NEXT_PUBLIC_CONTRACT_DEPLOYER=

# --- Gas sponsorship (app/api/sponsor/route.ts) -----------------------------
# Server-only - deliberately NOT prefixed NEXT_PUBLIC_, so it never reaches
# the browser bundle. Every transaction users submit through this app
# (deposit, redeem, lock/unlock, register, Zest supply/borrow) is sponsored:
# the wallet signs but doesn't pay the fee, and this key pays it instead.
#
# Fund this account with STX on whichever network(s) you want sponsorship
# to actually work on - every sponsored transaction spends real STX from
# it. Without this set, /api/sponsor returns a clear 503 and every write in
# the app will fail with "gas sponsorship isn't configured" rather than
# silently doing something else - there is no unsponsored fallback.
SPONSOR_PRIVATE_KEY=

# Flat fee (in microSTX) charged to the sponsor account per sponsored
# transaction. 3000 uSTX is a reasonable default for simple contract calls;
# raise it if transactions are getting stuck unconfirmed during congestion.
SPONSOR_FEE_USTX=3000
