# Copy to .env and fill in, or set these in whatever process manager runs
# the keeper (systemd unit, Docker env, etc). The keeper doesn't load a
# .env file on its own (see src/index.ts - it reads process.env directly,
# no dotenv dependency), so either:
#   node --env-file=.env node_modules/.bin/tsx src/index.ts
# or export these into the shell/service environment before `npm start`.

# Hiro API base URL. Use a mainnet-capable endpoint once NETWORK=mainnet -
# the public default (https://api.hiro.so) works for all three networks.
STACKS_API_URL=https://api.hiro.so

# The account that deployed bitmax-vault / ve-stx-lock / bitmax-boost-distributor
# - same value as the frontend's NEXT_PUBLIC_CONTRACT_DEPLOYER. Required.
CONTRACT_ADDRESS=

DISTRIBUTOR_CONTRACT_NAME=bitmax-boost-distributor

# devnet | testnet | mainnet. close-epoch's real StackingDAO/sBTC calls
# (via ve-stx-lock.claim-boost-reward) only succeed on mainnet - see
# submit.ts's own comment on SBTC_TOKEN_MAINNET/STSTXBTC_TRACKING_MAINNET.
NETWORK=devnet

# Must match bitmax-boost-distributor.clar's own EPOCH-LENGTH constant
# (currently 144 burn blocks, ~1 day) - a mismatch just means this keeper
# polls at the wrong cadence, the contract's own gate is authoritative
# either way.
EPOCH_LENGTH_BLOCKS=144

POLL_INTERVAL_SECS=60

# BLANK - a real private key that broadcasts close-epoch and pays its own
# gas fee (close-epoch is not sponsored, unlike the frontend's user-facing
# transactions - see submit.ts). Generate a dedicated wallet for this,
# fund it with STX on whichever network NETWORK above targets, and paste
# its private key here. Never commit this value anywhere.
KEEPER_PRIVATE_KEY=
